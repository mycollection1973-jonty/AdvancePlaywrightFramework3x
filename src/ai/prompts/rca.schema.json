{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://thetestingacademy.com/schemas/rca.schema.json",
  "title": "RcaVerdict",
  "description": "The shape CustomReporter's AI Verdict tab renders. Must stay in step with the RcaVerdict type in src/ai/agents/rcaAgent.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["severity", "priority", "rootCause", "fixes"],
  "properties": {
    "severity": {
      "enum": ["Critical", "High", "Medium", "Low"]
    },
    "priority": {
      "type": "string",
      "pattern": "^P[0-3]$"
    },
    "rootCause": {
      "type": "string",
      "minLength": 1
    },
    "fixes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
