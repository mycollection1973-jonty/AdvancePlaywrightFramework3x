{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://thetestingacademy.com/schemas/selfheal.schema.json",
  "title": "LocatorSuggestions",
  "description": "What the self-heal agent asks the model for. Match counts are NOT part of this: those are verified against the live page, never taken from the model.",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidates"],
  "properties": {
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["selector", "strategy", "reasoning"],
        "properties": {
          "selector": {
            "type": "string",
            "minLength": 1
          },
          "strategy": {
            "type": "string",
            "minLength": 1
          },
          "reasoning": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
